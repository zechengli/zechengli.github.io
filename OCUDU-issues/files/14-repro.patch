diff --git a/tests/unittests/rlc/rlc_tx_am_test.cpp b/tests/unittests/rlc/rlc_tx_am_test.cpp
index 032c635f41..e672faaa6d 100644
--- a/tests/unittests/rlc/rlc_tx_am_test.cpp
+++ b/tests/unittests/rlc/rlc_tx_am_test.cpp
@@ -2258,6 +2258,102 @@ TEST_P(rlc_tx_am_test, retx_count_ignores_pending_retx)
   EXPECT_EQ(tester->max_retx_count, 0);
 }
 
+/// Verify that an expiry of t-PollRetransmit does not count a new retransmission for an SDU that is still pending for
+/// retransmission, and does not queue a second RETX for its bytes that are still pending.
+/// - Window is stalled (max_window), SN=0 is NACKed and a RETX is scheduled (RETX_COUNT=0)
+/// - Only half of the RETX is transmitted, the rest is still pending in the RETX queue
+/// - t-PollRetransmit expires: no byte of SN=0 must be queued twice for RETX
+/// - The RETX is completed and t-PollRetransmit expires again (RETX_COUNT=1)
+/// - maxRetxThreshold=2 must not be reached yet
+TEST_P(rlc_tx_am_test, retx_count_poll_retransmit_expiry_ignores_pending_retx)
+{
+  const uint32_t sdu_size        = 10;
+  const uint32_t header_min_size = sn_size == rlc_am_sn_size::size12bits ? 2 : 3;
+  const uint32_t so_size         = 2;
+  const uint32_t n_pdus          = 5;
+
+  rlc_tx_am_config cfg_stall = config;
+  cfg_stall.max_window       = 4; // TX_Next=5 > max_window: window stalled after 5 SDUs
+  cfg_stall.max_retx_thresh  = 2;
+  auto rlc_stall             = std::make_unique<rlc_tx_am_entity>(gnb_du_id_t::min,
+                                                      du_ue_index_t::MIN_DU_UE_INDEX,
+                                                      drb_id_t::drb1,
+                                                      cfg_stall,
+                                                      *tester,
+                                                      *tester,
+                                                      *tester,
+                                                      *metrics_coll,
+                                                      pcap,
+                                                      pcell_worker,
+                                                      ue_worker,
+                                                      timers,
+                                                      get_window_pool());
+  rlc_stall->set_status_provider(tester.get());
+
+  // Send SN=0..4
+  for (uint32_t i = 0; i < n_pdus; i++) {
+    rlc_stall->handle_sdu(
+        test_helpers::create_pdcp_pdu(config.pdcp_sn_len, /* is_srb = */ false, i, sdu_size, i), false);
+  }
+  pcell_worker.run_pending_tasks();
+  for (uint32_t i = 0; i < n_pdus; i++) {
+    std::vector<uint8_t> pdu_buf(header_min_size + sdu_size);
+    ASSERT_EQ(rlc_stall->pull_pdu(pdu_buf), header_min_size + sdu_size);
+  }
+
+  // NACK SN=0 (first consideration for RETX: RETX_COUNT=0)
+  rlc_am_status_pdu status_pdu(sn_size);
+  status_pdu.ack_sn        = n_pdus;
+  rlc_am_status_nack nack0 = {};
+  nack0.nack_sn            = 0;
+  status_pdu.push_nack(nack0);
+  rlc_stall->on_status_pdu(std::move(status_pdu));
+  pcell_worker.run_pending_tasks();
+  ue_worker.run_pending_tasks();
+
+  // Transmit the first half of the RETX of SN=0 (carries a poll, so t-PollRetransmit is restarted)
+  {
+    std::vector<uint8_t> pdu_buf(header_min_size + sdu_size / 2);
+    ASSERT_EQ(rlc_stall->pull_pdu(pdu_buf), header_min_size + sdu_size / 2);
+  }
+
+  // Let t-PollRetransmit expire while the second half of the RETX of SN=0 is still pending
+  for (int32_t i = 0; i < config.t_poll_retx; i++) {
+    tick();
+  }
+
+  // Drain the RETX queue: no byte of SN=0 may be scheduled twice
+  std::vector<std::pair<uint32_t, uint32_t>> sn0_segments; // [so, so + len)
+  for (uint32_t i = 0; i < 10; i++) {
+    std::vector<uint8_t> pdu_buf(header_min_size + so_size + sdu_size);
+    size_t               pdu_len = rlc_stall->pull_pdu(pdu_buf);
+    if (pdu_len == 0) {
+      break;
+    }
+    pdu_buf.resize(pdu_len);
+    rlc_am_pdu_header hdr = {};
+    ASSERT_TRUE(
+        rlc_am_read_data_pdu_header(byte_buffer::create(pdu_buf.begin(), pdu_buf.end()).value(), sn_size, &hdr));
+    if (hdr.sn == 0) {
+      sn0_segments.emplace_back(hdr.so, hdr.so + pdu_len - hdr.get_packed_size());
+    }
+  }
+  for (size_t a = 0; a < sn0_segments.size(); a++) {
+    for (size_t b = a + 1; b < sn0_segments.size(); b++) {
+      EXPECT_FALSE(sn0_segments[a].first < sn0_segments[b].second && sn0_segments[b].first < sn0_segments[a].second)
+          << "SN=0 bytes [" << sn0_segments[a].first << "," << sn0_segments[a].second << ") and ["
+          << sn0_segments[b].first << "," << sn0_segments[b].second << ") were both queued for RETX";
+    }
+  }
+
+  // The RETX of SN=0 has been completed once. Let t-PollRetransmit expire again without any STATUS PDU.
+  for (int32_t i = 0; i < config.t_poll_retx; i++) {
+    tick();
+  }
+  // SN=0 has been considered for RETX twice (RETX_COUNT=1), so maxRetxThreshold=2 is not reached yet.
+  EXPECT_EQ(tester->max_retx_count, 0);
+}
+
 TEST_P(rlc_tx_am_test, retx_count_trigger_max_retx_without_segmentation)
 {
   const uint32_t sdu_size        = 4;
