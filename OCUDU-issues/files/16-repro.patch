+/// Verify t-Reassembly handling when only a non-first segment of SN = RX_Next_Reassembly has been received:
+/// - Rx last segment of SN=0: RX_Next_Highest = RX_Next_Reassembly + 1 with a missing byte segment in SN=0,
+///   so t-Reassembly is started with RX_Timer_Trigger=1 (TS 38.322 Sec. 5.2.2.2.3)
+/// - Rx first segment of SN=1
+/// - t-Reassembly expires: only SN=0 is discarded, SN=1 is kept for reassembly
+/// - Rx last segment of SN=1: SDU with SN=1 is delivered
+TEST_P(rlc_um_test, reassembly_timer_started_for_missing_first_segment_of_rx_next_reassembly)
+{
+  const uint32_t num_sdus = 2;
+  const uint32_t sdu_size = 10;
+
+  // Push SDUs into RLC1
+  byte_buffer sdu_bufs[num_sdus];
+  for (uint32_t i = 0; i < num_sdus; i++) {
+    sdu_bufs[i] = test_helpers::create_pdcp_pdu(config.tx.pdcp_sn_len, /* is_srb = */ false, i, sdu_size, i);
+    rlc1_tx_upper->handle_sdu(sdu_bufs[i].deep_copy().value(), false);
+  }
+  pcell_worker.run_pending_tasks();
+
+  // Read PDUs from RLC1 with grant of 8 Bytes each: first and last segment of each SDU
+  const uint32_t           payload_len = 8;
+  std::vector<byte_buffer> pdus;
+  std::vector<uint8_t>     pdu_tmp(payload_len);
+  while (rlc1_tx_lower->get_buffer_state().pending_bytes > 0 && pdus.size() < 2 * num_sdus) {
+    unsigned nwritten = rlc1_tx_lower->pull_pdu(pdu_tmp);
+    ASSERT_GT(nwritten, 0);
+    pdus.push_back(byte_buffer::create(span<uint8_t>{pdu_tmp.data(), nwritten}).value());
+  }
+  ASSERT_EQ(pdus.size(), 2 * num_sdus); // [0]: SN=0 first, [1]: SN=0 last, [2]: SN=1 first, [3]: SN=1 last
+
+  // Rx last segment of SN=0, then first segment of SN=1
+  rlc2_rx_lower->handle_pdu(pdus[1].deep_copy().value());
+  rlc2_rx_lower->handle_pdu(pdus[2].deep_copy().value());
+
+  // let t-reassembly expire
+  tick(config.rx.t_reassembly);
+
+  // Only SN=0 is lost
+  EXPECT_EQ(rlc2->get_metrics().rx.num_lost_pdus, 1);
+  EXPECT_EQ(tester2.sdu_counter, 0);
+
+  // Rx remaining segments
+  rlc2_rx_lower->handle_pdu(pdus[0].deep_copy().value());
+  rlc2_rx_lower->handle_pdu(pdus[3].deep_copy().value());
+
+  // SDU with SN=1 is delivered
+  ASSERT_EQ(tester2.sdu_counter, 1);
+  EXPECT_TRUE(sdu_bufs[1] == tester2.sdu_queue.front());
+}
