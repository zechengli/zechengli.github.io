diff --git a/tests/unittests/cu_cp/mobility/handover_reconfiguration_routine_test.cpp b/tests/unittests/cu_cp/mobility/handover_reconfiguration_routine_test.cpp
index 4e05b7a53f..17cdcf033f 100644
--- a/tests/unittests/cu_cp/mobility/handover_reconfiguration_routine_test.cpp
+++ b/tests/unittests/cu_cp/mobility/handover_reconfiguration_routine_test.cpp
@@ -149,6 +149,9 @@ TEST_F(handover_reconfiguration_routine_test, when_reconfiguration_successful_th
   f1ap_ue_context_modification_request context_mod = get_source_f1ap_ctxt_mod_request();
   ASSERT_TRUE(context_mod.drbs_to_be_setup_mod_list.empty());
   ASSERT_TRUE(context_mod.drbs_to_be_released_list.empty());
+
+  // A fallback release timer is armed for the source UE.
