 }
 
 TEST_F(handover_reconfiguration_routine_test, when_ue_context_mod_unsuccessful_then_return_false)
@@ -168,3 +171,25 @@ TEST_F(handover_reconfiguration_routine_test, when_ue_context_mod_unsuccessful_t
   // Reconfiguration complete was received.
   ASSERT_FALSE(get_result());
 }
+
+TEST_F(handover_reconfiguration_routine_test, when_ue_context_mod_unsuccessful_then_source_ue_still_gets_released)
+{
+  unsigned test_transaction_id = 35;
+
+  // Test Preamble.
+  create_ues(false, test_transaction_id);
+
+  set_sub_procedure_outcome(false);
+
+  start_procedure();
+
+  ASSERT_TRUE(procedure_ready());
+  ASSERT_FALSE(get_result());
+
+  // The UE CONTEXT MODIFICATION REQUEST carried Transmission Action Indicator = stop, which the source DU applies
+  // (and cannot undo, "restart" is not supported). The source UE must therefore not be left without any release
+  // path: either the fallback release timer is armed or a release is requested, like on the success path.
+  ASSERT_TRUE(get_source_f1ap_ctxt_mod_request().tx_action_ind.has_value());
+  EXPECT_TRUE(cu_cp_handler.release_timer_initialized or cu_cp_handler.ue_context_release_requested)
+      << "No fallback release was armed for the source UE after the failed UE Context Modification";
+}
