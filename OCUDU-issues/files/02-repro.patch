diff --git a/tests/unittests/du_manager/du_ue/ue_manager_test.cpp b/tests/unittests/du_manager/du_ue/ue_manager_test.cpp
index 2787dccbc4..7bea0a903b 100644
--- a/tests/unittests/du_manager/du_ue/ue_manager_test.cpp
+++ b/tests/unittests/du_manager/du_ue/ue_manager_test.cpp
@@ -505,3 +505,21 @@ TEST_F(du_ue_manager_rlf_tester, when_rlf_is_triggered_but_ue_removal_starts_the
   tick_until_rlf_timeout();
   ASSERT_FALSE(f1ap_dummy.last_ue_release_req.has_value());
 }
+
+// Documents current behaviour (passes on the current code): after a DRB-only Tx stop (Transmission Action Indicator
+// = stop, which the F1AP UE Context Modification procedure forwards to handle_ue_drb_deactivation_request), RLF
+// detection stays disabled for good. A later RLC max-retx RLF on the same UE never leads to a UE release request.
+TEST_F(du_ue_manager_rlf_tester, when_drb_tx_is_stopped_then_later_rlc_rlf_does_not_trigger_ue_release)
+{
+  // DU applies Transmission Action Indicator = stop for this UE.
+  ue_mng.schedule_async_task(test_ue_index, ue_mng.handle_ue_drb_deactivation_request(test_ue_index));
+  worker.run_pending_tasks();
+
+  // An RLC max-retx condition later occurs on the same UE.
+  rlf_detected(rlf_cause::max_rlc_retxs_reached);
+
+  // No release is requested even after the full RLF timer duration elapses, and the UE is still there.
+  tick_until_rlf_timeout();
+  EXPECT_FALSE(f1ap_dummy.last_ue_release_req.has_value());
+  EXPECT_NE(ue_mng.find_ue(test_ue_index), nullptr);
+}
