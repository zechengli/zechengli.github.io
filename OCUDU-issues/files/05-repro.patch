+/// A single PDCP status report whose FMC is more than 256 COUNTs ahead of TX_NEXT_ACK makes PDCP TX emit more than 256
+/// strictly contiguous on_discard_pdu() calls in one synchronous burst. In the CU-UP, this notifier is
+/// pdcp_f1u_adapter::on_discard_pdu() -> f1u_bearer_impl::discard_sdu().
+TEST_P(pdcp_tx_status_report_test, status_report_with_large_fmc_gap_emits_contiguous_discards)
+{
+  init(GetParam());
+  pdcp_tx->configure_security(sec_cfg, security::integrity_enabled::off, security::ciphering_enabled::off);
+  constexpr uint32_t n_sdus = 300;
+  for (uint32_t count = 0; count < n_sdus; ++count) {
+    pdcp_tx->handle_sdu(byte_buffer::create(sdu1).value());
+    wait_pending_crypto();
+    worker.run_pending_tasks();
+  }
+  test_frame.pdu_queue = {};
+  ASSERT_TRUE(test_frame.sdu_discard_queue.empty());
+
+  // Status report: FMC = n_sdus, no bitmap (all COUNTs < FMC confirmed received by the peer).
+  byte_buffer buf = {};
+  bit_encoder enc(buf);
+  enc.pack(to_number(pdcp_dc_field::control), 1);
+  enc.pack(to_number(pdcp_control_pdu_type::status_report), 3);
+  enc.pack(0b0000, 4);
+  enc.pack(n_sdus, 32);
+  pdcp_tx->on_status_report(byte_buffer_chain::create(std::move(buf)).value());
+
+  // All n_sdus discards are forwarded to the lower layer, strictly contiguous, in one synchronous call.
+  ASSERT_EQ(test_frame.sdu_discard_queue.size(), n_sdus);
+  for (uint32_t count = 0; count < n_sdus; ++count) {
+    ASSERT_EQ(test_frame.sdu_discard_queue.front(), pdcp_compute_sn(count, sn_size));
+    test_frame.sdu_discard_queue.pop();
+  }
+}
