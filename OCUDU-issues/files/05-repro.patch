+// Documents current behaviour (passes on the current code): a discard block with block_size = 0 is rejected as a
+// whole. None of the SDUs are discarded and they are still transmitted.
+TEST_P(rlc_tx_am_test, sdu_discard_with_zero_block_size_discards_nothing)
+{
+  const uint32_t sdu_size = 4;
+  const uint32_t n_pdus   = 3;
+
+  byte_buffer sdu_bufs[n_pdus];
+  for (uint32_t i = 0; i < n_pdus; i++) {
+    sdu_bufs[i] = test_helpers::create_pdcp_pdu(config.pdcp_sn_len, /* is_srb = */ false, i, sdu_size, i);
+    rlc->handle_sdu(sdu_bufs[i].deep_copy().value(), false);
+  }
+  pcell_worker.run_pending_tasks();
+
+  uint32_t header_size         = sn_size == rlc_am_sn_size::size12bits ? 2 : 3;
+  uint32_t data_pdu_size       = header_size + sdu_size;
+  uint32_t expect_buffer_state = n_pdus * data_pdu_size;
+  EXPECT_EQ(rlc->get_buffer_state().pending_bytes, expect_buffer_state);
+
+  test_spy.reset_counters();
+
+  // Block as emitted by the CU-UP F1-U bearer after 256 contiguous discards starting at pdcp_sn_start = 0.
+  rlc->discard_sdu(/* pdcp_sn_start = */ 0, /* block_size = */ 0);
+  pcell_worker.run_pending_tasks();
+
+  EXPECT_EQ(rlc->get_buffer_state().pending_bytes, expect_buffer_state);
+  EXPECT_EQ(rlc->get_metrics().tx_high.num_discarded_sdus, 0);
+  EXPECT_EQ(rlc->get_metrics().tx_high.num_discard_failures, 1);
+  EXPECT_EQ(test_spy.get_warning_counter(), 1);
+
+  // SDU with pdcp_sn = 0 is still transmitted.
+  std::vector<uint8_t> pdu_buf;
+  pdu_buf.resize(data_pdu_size);
+  size_t pdu_len = rlc->pull_pdu(pdu_buf);
+  pdu_buf.resize(pdu_len);
+  EXPECT_GT(pdu_len, 0);
+  EXPECT_TRUE(std::equal(pdu_buf.begin() + header_size, pdu_buf.end(), sdu_bufs[0].begin()));
+}
