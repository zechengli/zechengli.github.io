+/// 256 contiguous discards (e.g. from one PDCP status report whose FMC is 256 COUNTs ahead of TX_NEXT_ACK) cannot be
+/// described by one discard block, because the NR-U "Discarded Block size" field is one octet. They must be split
+/// into several blocks that together cover all 256 SNs, and no block may have size zero.
+TEST_F(f1u_cu_up_test, tx_discard_256_contiguous_sns_are_not_folded_into_a_zero_size_block)
+{
+  constexpr uint32_t pdcp_sn_start = 1000;
+  constexpr uint32_t nof_discards  = 256;
+
+  // advance time by one to ensure timer is stopped and ignores this tick
+  tick();
+
+  for (uint32_t i = 0; i < nof_discards; i++) {
+    f1u->discard_sdu(pdcp_sn_start + i);
+  }
+
+  // advance time to expire the DL notification timer and flush the accumulated blocks.
+  uint32_t f1u_dl_notif_time_ms = 5;
+  for (uint32_t t = 0; t < f1u_dl_notif_time_ms; t++) {
+    tick();
+  }
+
+  // Collect all discard blocks sent towards the DU.
+  uint32_t next_sn       = pdcp_sn_start;
+  uint32_t nof_blocks    = 0;
+  uint32_t nof_discarded = 0;
+  for (const auto& msg : tester->tx_msg_list) {
+    if (not msg.dl_user_data.discard_blocks.has_value()) {
+      continue;
+    }
+    for (const nru_pdcp_sn_discard_block& block : msg.dl_user_data.discard_blocks.value()) {
+      nof_blocks++;
+      EXPECT_NE(static_cast<unsigned>(block.block_size), 0U)
+          << "discard block with zero size: pdcp_sn_start=" << block.pdcp_sn_start;
+      EXPECT_EQ(block.pdcp_sn_start, next_sn);
+      next_sn += block.block_size;
+      nof_discarded += block.block_size;
+    }
+  }
+  EXPECT_GE(nof_blocks, 2);
+  EXPECT_EQ(nof_discarded, nof_discards);
+}
+
