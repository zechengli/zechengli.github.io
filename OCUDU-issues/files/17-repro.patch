+/// Verify that the lower layer keeps receiving buffer state updates after a buffer state update task was accepted by
+/// the pcell executor but later discarded by it (see the corresponding test in rlc_tx_am_test).
+TEST_P(rlc_um_test, buffer_state_update_after_discarded_pcell_task)
+{
+  // Worker pool whose queue can be made to reject new tasks.
+  class gated_executor : public task_executor
+  {
+  public:
+    manual_task_worker worker{128};
+    bool               accept = true;
+    [[nodiscard]] bool execute(unique_task task) override { return accept and worker.execute(std::move(task)); }
+    [[nodiscard]] bool defer(unique_task task) override { return accept and worker.defer(std::move(task)); }
+  };
+  gated_executor pool_exec;
+
+  // Cell strand as created by strand_cell_worker_executor_mapper: execs[0] for slot_ind/MAC, execs[1] for RLC lower.
+  concurrent_queue_params qparams{concurrent_queue_policy::lockfree_mpmc, 128};
+  priority_task_strand<task_executor*, force_dispatch_strand_lock<enqueue_priority::max>> cell_strand(
+      &pool_exec, std::array<concurrent_queue_params, 2>{qparams, qparams});
+  auto execs = cell_strand.get_executors();
+
+  rlc_test_frame local_tester;
+  null_rlc_pcap  local_pcap;
+  auto           local_rlc = std::make_unique<rlc_um_entity>(gnb_du_id_t::min,
+                                                   du_ue_index_t::MIN_DU_UE_INDEX,
+                                                   drb_id_t::drb1,
+                                                   config,
+                                                   std::chrono::milliseconds(0),
+                                                   nullptr,
+                                                   local_tester,
+                                                   local_tester,
+                                                   local_tester,
+                                                   local_tester,
+                                                   local_pcap,
+                                                   execs[1],
+                                                   ue_worker,
+                                                   timers,
+                                                   get_window_pool());
+  rlc_tx_upper_layer_data_interface* tx_upper = local_rlc->get_tx_upper_layer_data_interface();
+
+  // Queue an SDU. The buffer state update task is accepted by the strand, which dispatches a job to the pool.
+  tx_upper->handle_sdu(construct_sdu(0, 10), false);
+
+  // The pool queue is full while a slot indication is pushed to the strand. The strand discards its pending tasks.
+  pool_exec.accept = false;
+  EXPECT_FALSE(execs[0].defer([]() {}));
+
+  // The pool recovers.
+  pool_exec.accept = true;
+  pool_exec.worker.run_pending_tasks();
+
+  // Queue more SDUs. The lower layer must be notified.
+  for (uint8_t i = 1; i < 4; i++) {
+    tx_upper->handle_sdu(construct_sdu(i, 10), false);
+    pool_exec.worker.run_pending_tasks();
+  }
+  EXPECT_GT(local_tester.bsr_count, 0);
+  EXPECT_GT(local_tester.bsr.pending_bytes, 0);
+}
