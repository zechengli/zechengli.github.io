diff --git a/tests/unittests/cu_cp/cu_cp_reestablishment_test.cpp b/tests/unittests/cu_cp/cu_cp_reestablishment_test.cpp
--- a/tests/unittests/cu_cp/cu_cp_reestablishment_test.cpp
+++ b/tests/unittests/cu_cp/cu_cp_reestablishment_test.cpp
@@ -720,4 +720,69 @@
   ASSERT_EQ(report.dus[0].rrc_metrics.successful_rrc_connection_reestablishments_with_ue_context, 1);
   // Old UE should not be removed at this stage.
   ASSERT_EQ(report.ues.size(), 1) << "Old UE should not be removed yet";
+
+  // Cancelling the old UE's procedures must not lead to a UE Context Release Request for the reestablished UE.
+  ngap_message ngap_pdu;
+  while (get_amf().try_pop_rx_pdu(ngap_pdu)) {
+    EXPECT_FALSE(test_helpers::is_valid_ue_context_release_request(ngap_pdu))
+        << "UE Context Release Request sent for a UE that has just reestablished";
+  }
+}
+
+TEST_F(cu_cp_reestablishment_test,
+       when_reestablishment_cancels_pending_pdu_session_setup_then_reestablished_ue_is_not_released)
+{
+  // Attach UE 0x4601 (with PDU session 1).
+  ASSERT_TRUE(attach_ue(du_idx, cu_up_idx, old_du_ue_id, old_crnti, amf_ue_id, cu_up_e1ap_id));
+  const ran_ue_id_t ran_ue_id = find_ue_context(du_idx, old_du_ue_id)->ran_ue_id.value();
+
+  // The AMF requests a second PDU session. Run it until the CU-CP sends the RRC Reconfiguration, which the UE never
+  // acknowledges.
+  const pdu_session_id_t psi2 = uint_to_pdu_session_id(2);
+  ASSERT_TRUE(send_pdu_session_resource_setup_request_and_await_bearer_context_modification_request(
+      generate_valid_pdu_session_resource_setup_request_message(
+          amf_ue_id, ran_ue_id, {{psi2, {pdu_session_type_t::ipv4, {{uint_to_qos_flow_id(1), 9}}}}}),
+      du_idx));
+  ASSERT_TRUE(send_bearer_context_modification_response_and_await_ue_context_modification_request(
+      du_idx, cu_up_idx, old_du_ue_id, psi2, drb_id_t::drb2, uint_to_qos_flow_id(1)));
+  ASSERT_TRUE(send_ue_context_modification_response_and_await_bearer_context_modification_request(
+      du_idx, cu_up_idx, old_du_ue_id, old_crnti));
+  ASSERT_TRUE(send_bearer_context_modification_response_and_await_rrc_reconfiguration(
+      du_idx, cu_up_idx, old_du_ue_id, {}, {{psi2, drb_id_t::drb2}}));
+
+  // The UE declares RLF and reestablishes successfully.
+  const gnb_du_ue_f1ap_id_t new_du_ue_id = int_to_gnb_du_ue_f1ap_id(1);
+  const rnti_t              new_crnti    = to_rnti(0x4602);
+  ASSERT_TRUE(reestablish_ue(du_idx, cu_up_idx, new_du_ue_id, new_crnti, old_crnti, old_pci));
+
+  // The cancelled PDU session setup is answered to the AMF, but the CU-CP must not ask the AMF to release the UE.
+  ngap_message ngap_pdu;
+  bool         release_requested = false;
+  while (get_amf().try_pop_rx_pdu(ngap_pdu)) {
+    release_requested |= test_helpers::is_valid_ue_context_release_request(ngap_pdu);
+  }
+  EXPECT_FALSE(release_requested) << "UE Context Release Request sent for a UE that has just reestablished";
+
+  if (release_requested) {
+    // The AMF answers the request. Complete the resulting E1AP and F1AP releases.
+    get_amf().push_tx_pdu(generate_valid_ue_context_release_command_with_amf_ue_ngap_id(amf_ue_id));
+    const auto*  new_ctx = find_ue_context(du_idx, new_du_ue_id);
+    e1ap_message e1ap_pdu;
+    ASSERT_TRUE(wait_for_e1ap_tx_pdu(cu_up_idx, e1ap_pdu));
+    ASSERT_TRUE(test_helpers::is_valid_bearer_context_release_command(e1ap_pdu));
+    get_cu_up(cu_up_idx).push_tx_pdu(
+        generate_bearer_context_release_complete(new_ctx->cu_cp_e1ap_id.value(), new_ctx->cu_up_e1ap_id.value()));
+    f1ap_message f1ap_pdu;
+    ASSERT_TRUE(wait_for_f1ap_tx_pdu(du_idx, f1ap_pdu));
+    ASSERT_TRUE(test_helpers::is_valid_ue_context_release_command(f1ap_pdu));
+    get_du(du_idx).push_ul_pdu(
+        test_helpers::generate_ue_context_release_complete(new_ctx->cu_ue_id.value(), new_du_ue_id));
+  }
+  tick_until(std::chrono::milliseconds{1000}, [] { return false; }, /*real_time=*/false);
+
+  // The reestablished UE must still be there and connected.
+  auto report = get_cu_cp().get_metrics_handler().request_metrics_report();
+  ASSERT_EQ(report.ues.size(), 1U) << "The reestablished UE was released";
+  EXPECT_EQ(report.ues[0].rnti, new_crnti);
+  EXPECT_EQ(report.ues[0].rrc_connection_state, rrc_state::connected);
 }
